# Copy to .env.local for development. NEXT_PUBLIC_* values ship in the
# client bundle and are inlined at build time (set them on Vercel too).

# Backend API base (NestJS, global prefix /api).
NEXT_PUBLIC_API_BASE_URL=https://api.restocare.in/api
NEXT_PUBLIC_GOOGLE_AUTH_URL=

# Feature flags (see src/lib/*-flow.ts).
NEXT_PUBLIC_BOOKING_FLOW=1
NEXT_PUBLIC_DEEP_CLEANING_FLOW=1
NEXT_PUBLIC_RC_CATEGORY_FLOW=1
NEXT_PUBLIC_SHOW_BOOKING_ANIMATIONS=1

# Meta Pixel + Conversions API (see README "Meta Pixel").
# Pixel id from Events Manager > Data sources > "Restocare".
NEXT_PUBLIC_META_PIXEL_ID=1005610329177258
