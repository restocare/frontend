# Production build env (committed on purpose — these are PUBLIC, non-secret values
# that ship in the client bundle anyway). NEXT_PUBLIC_* vars are inlined at build
# time, so Vercel must have them at build; .env.local is gitignored and never
# reaches Vercel, which is why prod was falling back to http://localhost:8000/api.
#
# NestJS global prefix is /api, URI versioning => /v1.
NEXT_PUBLIC_API_BASE_URL=https://api.restocare.in/api

# Where "Continue with Google" sends the user to start OAuth on the backend.
NEXT_PUBLIC_GOOGLE_AUTH_URL=https://api.restocare.in/api/v1/auth/google

# Deep Cleaning design: 1 = current production page, 2 = the new flow-2 design
# (src/lib/deep-cleaning-flow.ts). Stays on 1 until the new design is complete.
NEXT_PUBLIC_DEEP_CLEANING_FLOW=1
